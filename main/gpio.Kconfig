menu "gpio0"
  choice ESP32_GPIO0_FUNC
    prompt "Function"
    default ESP32_GPIO0_FUNC_EMAC_TX_CLK if ETH_RMII_CLK_INPUT || ETH_RMII_CLK_OUTPUT_GPIO0
    default ESP32_GPIO0_FUNC_GPIO

    config ESP32_GPIO0_FUNC_GPIO
      bool "GPIO"
    config ESP32_GPIO0_FUNC_GPIO_INPUT
      bool "GPIO (input)"
    config ESP32_GPIO0_FUNC_GPIO_OUTPUT
      bool "GPIO (output)"
    config ESP32_GPIO0_FUNC_EMAC_TX_CLK
      bool "EMAC_TX_CLK"
  endchoice

  config ESP32_GPIO0_NAME
    string "Name"

    default "EMAC_TX_CLK" if ESP32_GPIO0_FUNC_EMAC_TX_CLK
    default "GPIO0"

  config ESP32_GPIO0_RESERVED
    bool "Reserved"

    default y if ESP32_GPIO0_FUNC_EMAC_TX_CLK
endmenu

