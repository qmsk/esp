CONFIG_ESP32_GPIO5_FUNC_GPIO_OUTPUT=y
CONFIG_ESP32_GPIO5_NAME="LEDS_OUTPUT_ENABLE_ALT"

CONFIG_ESP32_GPIO12_FUNC_GPIO_OUTPUT=y
CONFIG_ESP32_GPIO12_NAME="LEDS_DATA_1"

CONFIG_ESP32_GPIO13_FUNC_GPIO_OUTPUT=y
CONFIG_ESP32_GPIO13_NAME="USER_LED_ALERT"
CONFIG_ESP32_GPIO13_RESERVED=y

CONFIG_ESP32_GPIO14_FUNC_GPIO_OUTPUT=y
CONFIG_ESP32_GPIO14_NAME="USER_LED_NONE"
