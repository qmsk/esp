CONFIG_ESP32_GPIO15_FUNC_GPIO_OUTPUT=y
CONFIG_ESP32_GPIO15_NAME="USER_LED_USER"
CONFIG_ESP32_GPIO15_RESERVED=y

CONFIG_ESP32_GPIO16_FUNC_GPIO_OUTPUT=y
CONFIG_ESP32_GPIO16_NAME="LEDS_DATA_2"

CONFIG_ESP32_GPIO17_FUNC_GPIO_OUTPUT=y
